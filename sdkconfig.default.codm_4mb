menu "Board Configuration"

choice BOARD_TYPE
    prompt "Select Board Type"
    default BOARD_GENERIC
    help
        Select the target board type.
        Different boards have different GPIO configurations.

config BOARD_GENERIC
    bool "Generic ESP32 Board"
    help
        Generic ESP32 board with default pin configuration

config BOARD_CODM_4MB
    bool "CODM 4MB Board with Ethernet"
    help
        CODM board with 4MB flash and LAN8720A Ethernet support

endchoice

endmenu

menu "Ethernet Configuration"
    depends on BOARD_CODM_4MB

config ENABLE_ETHERNET
    bool "Enable Ethernet Support"
    default y
    depends on BOARD_CODM_4MB
    help
        Enable LAN8720A Ethernet support on CODM board.
        When Ethernet is active, WiFi will be disabled.

config ETH_MDC_GPIO
    int "Ethernet MDC GPIO"
    default 23
    depends on ENABLE_ETHERNET
    help
        GPIO pin for Ethernet MDC (Management Data Clock)

config ETH_MDIO_GPIO
    int "Ethernet MDIO GPIO"
    default 18
    depends on ENABLE_ETHERNET
    help
        GPIO pin for Ethernet MDIO (Management Data I/O)

config ETH_PHY_ADDR
    int "Ethernet PHY Address"
    default 0
    range 0 31
    depends on ENABLE_ETHERNET
    help
        PHY address of LAN8720A (typically 0 or 1)

config ETH_PHY_POWER_GPIO
    int "Ethernet PHY Power GPIO (-1 to disable)"
    default -1
    depends on ENABLE_ETHERNET
    help
        GPIO pin for PHY power enable. Set to -1 if not used.

config ETH_PHY_RST_GPIO
    int "Ethernet PHY Reset GPIO (-1 to disable)"
    default -1
    depends on ENABLE_ETHERNET
    help
        GPIO pin for PHY reset. Set to -1 if not used.

choice ETH_CLOCK_MODE
    prompt "Ethernet Clock Mode"
    default ETH_CLOCK_GPIO0_IN
    depends on ENABLE_ETHERNET
    help
        Select Ethernet clock mode for LAN8720A

config ETH_CLOCK_GPIO0_IN
    bool "GPIO0 Input (50MHz from external oscillator)"
    help
        Use 50MHz clock from external oscillator on GPIO0

config ETH_CLOCK_GPIO0_OUT
    bool "GPIO0 Output (50MHz from ESP32)"
    help
        ESP32 generates 50MHz clock on GPIO0

config ETH_CLOCK_GPIO16_OUT
    bool "GPIO16 Output (50MHz from ESP32)"
    help
        ESP32 generates 50MHz clock on GPIO16

config ETH_CLOCK_GPIO17_OUT
    bool "GPIO17 Output (50MHz from ESP32)"
    help
        ESP32 generates 50MHz clock on GPIO17

endchoice

endmenu

menu "Wi-Fi Configuration"

config WIFI_BACKUP_SSID
    string "Backup WiFi SSID for Configuration"
    default "UDP2DMX-Config"
    help
        SSID des Config-WiFi für Notfall-Konfiguration.
        Wird verwendet wenn primäres WiFi nicht erreichbar ist.

config WIFI_BACKUP_PASSWORD
    string "Backup WiFi Password (empty for open)"
    default "12345678"
    help
        Passwort des Backup-WiFi. Leer lassen für offenes Netzwerk.

config WIFI_CONFIG_MODE_TIMEOUT_SEC
    int "Config Mode Timeout (seconds)"
    default 300
    help
        Timeout für Config-Mode. Danach wird Neustart versucht.
        0 = Kein Timeout (bleibt im Config-Mode)

endmenu

menu "Hardware Configuration"

config DMX_TX_GPIO
    int "RS485 Output 1 TX GPIO Pin"
    default 17
    help
        GPIO Pin fuer RS485 Output 1 TX (DI)

config DMX_RX_GPIO
    int "RS485 Output 1 RX GPIO Pin"
    default 16
    help
        GPIO Pin fuer RS485 Output 1 RX (RO)

config DMX_RTS_GPIO
    int "RS485 Output 1 RTS GPIO Pin (DE)"
    default 18
    help
        GPIO Pin fuer RS485 Output 1 DE/RTS

config DMX_UART_NUM
    int "RS485 Output 1 UART Number"
    default 2
    range 0 2
    help
        UART Nummer fuer RS485 Output 1 (0, 1 oder 2)

config RS485_2_TX_GPIO
    int "RS485 Output 2 TX GPIO Pin"
    default 25
    help
        GPIO Pin fuer RS485 Output 2 TX (DI)

config RS485_2_RX_GPIO
    int "RS485 Output 2 RX GPIO Pin"
    default 26
    help
        GPIO Pin fuer RS485 Output 2 RX (RO)

config RS485_2_RTS_GPIO
    int "RS485 Output 2 RTS GPIO Pin (DE)"
    default 27
    help
        GPIO Pin fuer RS485 Output 2 DE/RTS

config RS485_2_UART_NUM
    int "RS485 Output 2 UART Number"
    default 1
    range 0 2
    help
        UART Nummer fuer RS485 Output 2 (0, 1 oder 2)

config DMX_ACTIVE_OUTPUT
    int "Aktiver RS485 Ausgang fuer DMX (1 oder 2)"
    default 1
    range 1 2
    help
        Waehlt, welcher RS485 Ausgang fuer DMX verwendet wird.
        Diese Voreinstellung kann spaeter im Webinterface geaendert werden.

config DMX_BAUDRATE
    int "DMX Baudrate"
    default 250000
    help
        Baudrate für DMX (standard: 250000 baud)

config DMX_FADE_INTERVAL_MS
    int "DMX Fade Interval (ms)"
    default 10
    range 1 1000
    help
        Aktualisierungsintervall für das Fading in Millisekunden (1-1000).

config WIFI_SWITCH_BUTTON_GPIO
    int "GPIO for network selection (optional)"
    default 0
    help
        GPIO Pin für manuellen Netzwerkwechsel (0 = deaktiviert)

config DEBUG_LED_GPIO
    int "Debug LED GPIO Pin"
    default 2
    help
        GPIO Pin für Debug/Status LED

endmenu
